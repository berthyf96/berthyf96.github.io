{
  "name": "berthyfeng.com",
  "version": "1.0.0",
  "description": "Build scripts for berthyfeng.com",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git://github.com/berthyf96/berthyf96.github.io.git"
  },
  "license": "MIT",
  "scripts": {
    "scss": "sass --style compressed --sourcemap=none assets/_scss/main.scss assets/css/main.css",
    "uglify": "uglifyjs assets/js/vendor/jquery/jquery-1.12.4.min.js assets/js/plugins/jquery.greedy-navigation.js -c -m -o assets/js/main.min.js",
    "build:css": "npm run scss",
    "build:js": "npm run uglify",
    "build:all": "npm run build:css && npm run build:js",
    "watch": "onchange \"assets/_scss/**/*.scss\" -- npm run build:css"
  },
  "devDependencies": {
    "npm-run-all": "^1.7.0",
    "onchange": "^2.2.0",
    "uglify-js": "^2.6.1"
  }
}
